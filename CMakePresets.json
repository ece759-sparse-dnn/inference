{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug (CPU)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "asan",
      "inherits": "debug",
      "displayName": "Debug + ASan/UBSan (Linux)",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release (CPU)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-march=native"
      }
    },
    {
      "name": "cuda-euler",
      "inherits": "release",
      "displayName": "Release + CUDA (Euler)",
      "cacheVariables": {
        "SDNN_ENABLE_CUDA": "ON",
        "CMAKE_CUDA_ARCHITECTURES": "89"
      }
    },
    {
      "name": "cuda-chtc",
      "inherits": "release",
      "displayName": "Release + CUDA (CHTC)",
      "cacheVariables": {
        "SDNN_ENABLE_CUDA": "ON",
        "CMAKE_CUDA_ARCHITECTURES": "80;89;90;120"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "release", "configurePreset": "release" },
    { "name": "cuda-euler", "configurePreset": "cuda-euler" },
    { "name": "cuda-chtc", "configurePreset": "cuda-chtc" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true }
    }
  ]
}
